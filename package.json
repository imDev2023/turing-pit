{
  "name": "turing-pit",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "runner": "pnpm --filter @turing-pit/runner start",
    "web": "pnpm --filter @turing-pit/web dev",
    "build:web": "pnpm --filter @turing-pit/web build",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "jito-ts>@solana/web3.js": "^1.98.4"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
